<?xml version="1.0"?>
<scenario>
	<environment>
		<ned latitude="56.136459" longitude="-2.706819"/>
		<ocean>
			<water density="1031.0" jerlov="0.15"/>
			<waves height="0.0"/>
			<particles enabled="true"/>
			<current type="uniform">
				<velocity xyz="0.0 0.0 0.0"/>
			</current>
			<current type="jet">
				<center xyz="0.0 0.0 0.0"/>
				<outlet radius="100.0"/>
				<velocity xyz="0.0 0.0 0.0"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="45.0" elevation="90.0"/>
		</atmosphere>
	</environment>

	<materials>
		<material name="Neutral" density="1000.0" restitution="0.1"/>
		<material name="Rock" density="3000.0" restitution="0.8"/>
		<material name="Fiberglass" density="1500.0" restitution="0.3"/>
		<material name="Aluminium" density="2710.0" restitution="0.5"/>

        <!-- Added for QUT ROV -->
        <material name="ROVMat" density="1000.0" restitution="0.3"/>

		<friction_table>
			<friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Rock" static="0.2" dynamic="0.1"/>
			<friction material1="Neutral" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Aluminium" static="0.1" dynamic="0.02"/>
			<friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7"/>
			<friction material1="Rock" material2="Fiberglass" static="0.6" dynamic="0.4"/>
			<friction material1="Rock" material2="Aluminium" static="0.6" dynamic="0.3"/>
			<friction material1="Fiberglass" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Fiberglass" material2="Aluminium" static="0.5" dynamic="0.2"/>
			<friction material1="Aluminium" material2="Aluminium" static="0.8" dynamic="0.5"/>

            <!-- Added for QUT ROV -->
            <friction material1="ROVMat" material2="ROVMat" static="0.6" dynamic="0.4"/>
            <friction material1="ROVMat" material2="Rock" static="0.7" dynamic="0.5"/>
            <friction material1="ROVMat" material2="Aluminium" static="0.7" dynamic="0.5"/>
            <friction material1="ROVMat" material2="Neutral" static="0.6" dynamic="0.4"/>
		</friction_table>
	</materials>

	<looks>
		<look name="black" gray="0.05" roughness="0.2"/>
		<look name="yellow" rgb="1.0 0.9 0.0" roughness="0.3"/>
		<look name="gray" gray="0.5" roughness="0.4" metalness="0.5"/>
		<look name="ltgray" gray="0.75" roughness="1.0" metalness="0.0"/>
		<look name="tank" rgb="0.9 0.9 0.9" roughness="0.9"/>
		<look name="duct" gray="0.1" roughness="0.4" metalness="0.5"/>

        <!-- Added for QUT ROV -->
        <look name="ROVLook" rgb="0.30 0.30 0.35" roughness="0.5"/>

    	<look name="sand"
          gray="1.0"
          roughness="0.7"
          metalness="0.3"
          texture="cad_model_data/ocean_test_data/SoilBeach0078_1_350.jpg"/>

    	<look name="gas_canister"
          gray="1.0"
          roughness="0.5"
          metalness="0.3"
          texture="cad_model_data/ocean_test_data/gas_canister.png"/>

    	<look name="gas_tank"
          gray="1.0"
          roughness="0.5"
          metalness="0.5"
          texture="cad_model_data/ocean_test_data/gas_tank.png"/>

    	<look name="oil_drum"
          gray="1.0"
          roughness="0.5"
          metalness="0.2"
          texture="cad_model_data/ocean_test_data/oil_drum.png"/>

    	<look name="rust_pipe"
          gray="1.0"
          roughness="0.5"
          metalness="0.2"
          texture="cad_model_data/ocean_test_data/rust_pipe.png"/>

    	<look name="anode_bar"
          gray="1.0"
          roughness="0.5"
          metalness="0.2"
          texture="cad_model_data/ocean_test_data/anode_d.png"/>

        <look name="turbine_base" gray="1.0" roughness="0.4" metalness="0.5" texture="cad_model_data/ocean_test_data/Turbine_Base_Diffuse.png"/>
		<look name="turbine_main" gray="1.0" roughness="0.4" metalness="0.5" texture="cad_model_data/ocean_test_data/Turbine_Main_Diffuse.png"/>
	</looks>

	<static name="Seabed" type="model">
		<physical>
			<mesh filename="cad_model_data/ocean_test_data/flat.obj" scale="1.0"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="Rock"/>
		<look name="sand"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 6.0"/>
	</static>

	<static name="Canister1" type="model">
		<physical>
			<mesh filename="cad_model_data/ocean_test_data/gas_canister.obj" scale="1"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="Aluminium"/>
		<look name="gas_canister"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="4.0 0.0 5.1"/>
	</static>

	<static name="Gastank1" type="model">
		<physical>
			<mesh filename="cad_model_data/ocean_test_data/gas_tank.obj" scale="1"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="Aluminium"/>
		<look name="gas_tank"/>
		<world_transform rpy="-1.57 0.0 0.0" xyz="0.0 -4.0 5.1"/>
	</static>

	<static name="Gastank2" type="model">
		<physical>
			<mesh filename="cad_model_data/ocean_test_data/gas_tank.obj" scale="1"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="Aluminium"/>
		<look name="gas_tank"/>
		<world_transform rpy="-1.57 0.0 0.0" xyz="3.0 3.0 5.0"/>
	</static>

	<static name="Oildrum1" type="model">
		<physical>
			<mesh filename="cad_model_data/ocean_test_data/oil_drum.obj" scale="1"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="Aluminium"/>
		<look name="oil_drum"/>
		<world_transform rpy="-1.57 0.0 -1.57" xyz="0.0 4.0 5.0"/>
	</static>

	<static name="Oildrum2" type="model">
		<physical>
			<mesh filename="cad_model_data/ocean_test_data/oil_drum.obj" scale="1"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="Aluminium"/>
		<look name="oil_drum"/>
		<world_transform rpy="0.0 0.0 -1.57" xyz="-3.0 -3.0 5.1"/>
	</static>

	<static name="Rustpipe" type="model">
		<physical>
			<mesh filename="cad_model_data/ocean_test_data/rust_pipe.obj" scale="1"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="Aluminium"/>
		<look name="rust_pipe"/>
		<world_transform rpy="0.0 1.57 1.57" xyz="-4.0 0.0 5.3"/>
	</static>

    <!-- Embedded QUT ROV directly instead of include -->
    <dynamic name="QUT_ROV" type="model" physics="submerged" buoyant="true">
        <physical>
            <mesh filename="/home/brad/Desktop/EGH490/ros2_ws/src/stonefish_qut_rov/cad_model_data/Subbyrov_phy.obj"
                  scale="1.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </physical>

        <visual>
            <mesh filename="/home/brad/Desktop/EGH490/ros2_ws/src/stonefish_qut_rov/cad_model_data/Subbyrov_phy.obj"
                  scale="1.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>

        <material name="ROVMat"/>
        <look name="ROVLook"/>
        <mass value="4.089"/>
        <world_transform xyz="0 0 0.5" rpy="0 0 0"/>
    </dynamic>

</scenario>