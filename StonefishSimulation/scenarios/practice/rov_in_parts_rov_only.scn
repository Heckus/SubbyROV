<?xml version="1.0"?>
<scenario>

    <looks>
        <!-- QUT ROV looks -->
        <look name="rov_body" gray="0.55" roughness="0.45" metalness="0.25"/>
        <look name="foam" rgb="0.15 0.15 0.15" roughness="0.80"/>
        <look name="thruster" rgb="0.05 0.05 0.05" roughness="0.50"/>
        <look name="camera" rgb="0.10 0.10 0.10" roughness="0.40"/>
    </looks>

    <robot name="$(arg vehicle_name)" fixed="false" self_collisions="false">

        <base_link name="base_link" type="compound" physics="submerged">

            <external_part name="Hull" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="cad_model_data/rov_models/2k_N_hole.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0 0.0 0.0"/>
                    <!-- <thickness value="0.005"/> -->
                </physical>
                <visual>
                    <mesh filename="cad_model_data/rov_models/8k_no_holes_blender.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0 0.0 0.0"/>
                </visual>
                <material name="HullMat"/>
                <look name="rov_body"/>
                <mass value="1.4126"/>
                <compound_transform xyz="0 0 0" rpy="0 0 0"/>
            </external_part>

            <internal_part name="wte" type="cylinder" physics="submerged" buoyant="true">
                <dimensions radius="0.044" height="0.26"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="HullMat"/>
                <look name="None"/>
                <mass value="0.884"/>
                <!-- <compound_transform xyz="0.00516 -0.00060 -0.00086" rpy="0 1.5708 0"/> -->
                <compound_transform xyz="0.045 -0.00060 -0.00086" rpy="0 1.5708 0"/>
            </internal_part>

            <internal_part name="FoamLeft" type="box" physics="submerged" buoyant="true">
                <dimensions xyz="0.24 0.06 0.05"/>
                <origin xyz="0.0 0.0 0.0" rpy="-0.7854 0.0 0.0"/>
                <material name="FoamMat"/>
                <look name="None"/>
                <mass value="0.0612"/>
                <compound_transform xyz="-0.03099 -0.06936 -0.05037" rpy="0 0.0 0.0"/>
            </internal_part>

            <internal_part name="FoamRight" type="box" physics="submerged" buoyant="true">
                <dimensions xyz="0.24 0.06 0.05"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.7854 0.0 0.0"/>
                <material name="FoamMat"/>
                <look name="None"/>
                <mass value="0.0612"/>
                <compound_transform xyz="-0.03027 0.07142 -0.05037" rpy="0.0 0.0 0.0"/>
            </internal_part>

            <internal_part name="Thruster_BL" type="sphere" physics="submerged">
                <dimensions radius="0.02"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="ElectronicsMat"/>
                <look name="None"/>
                <mass value="0.21"/>
                <compound_transform xyz="-0.08625 -0.13998 0.00651" rpy="0.0 0.0 0.0"/>
            </internal_part>

            <internal_part name="Thruster_BR" type="sphere" physics="submerged">
                <dimensions radius="0.02"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="ElectronicsMat"/>
                <look name="None"/>
                <mass value="0.21"/>
                <compound_transform xyz="-0.08569 0.14131 0.00771" rpy="0.0 0.0 0.0"/>
            </internal_part>

            <internal_part name="Thruster_TL" type="sphere" physics="submerged">
                <dimensions radius="0.02"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="ElectronicsMat"/>
                <look name="None"/>
                <mass value="0.21"/>
                <compound_transform xyz="0.00201 -0.14498 0.00905" rpy="0.0 0.0 0.0"/>
            </internal_part>

            <internal_part name="Thruster_TR" type="sphere" physics="submerged">
                <dimensions radius="0.02"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="ElectronicsMat"/>
                <look name="None"/>
                <mass value="0.21"/>
                <compound_transform xyz="0.00257 0.14631 0.00925" rpy="0.0 0.0 0.0"/>
            </internal_part>

            <internal_part name="dome" type="sphere" physics="submerged" buoyant="true">
                <dimensions radius="0.0325"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="HullMat"/>
                <look name="None"/>                
                <mass value="0.026"/>
                <compound_transform xyz="0.17 -0.00046 -0.00106" rpy="0.0 0.0 0.0"/>
            </internal_part>

            <internal_part name="light" type="cylinder" physics="submerged" buoyant="true">
                <dimensions radius="0.01737" height="0.03474"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="HullMat"/>
                <look name="None"/>                
                <mass value="0.118"/>
                <compound_transform xyz="0.0512 -0.01445 0.1047" rpy="0 1.5708 0"/>
            </internal_part>

            <internal_part name="FrameBarLeft" type="box" physics="submerged" buoyant="true">
                <dimensions xyz="0.131 0.01864 0.014"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="HullMat"/>
                <look name="None"/>
                <mass value="0.08"/>
                <compound_transform xyz="0.0 -0.07857 0.005" rpy="0 0 0"/>
            </internal_part>

            <internal_part name="FrameBarRight" type="box" physics="submerged" buoyant="true">
                <dimensions xyz="0.131 0.01864 0.014"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="HullMat"/>
                <look name="None"/>
                <mass value="0.08"/>
                <compound_transform xyz="0.0 0.07857 0.005" rpy="0 0 0"/>
            </internal_part>

        </base_link>

        <actuator name="TL" type="thruster">
            <link name="base_link"/>
            <origin xyz="0.00201 -0.14498 0.00905" rpy="0 -1.5708 0"/>
            <specs max_setpoint="3600.0" inverted_setpoint="false" normalized_setpoint="false"/>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="fluid_dynamics">
                <rotor_constant value="0.001"/>
                <thrust_coeff forward="0.043" reverse="0.043"/>
                <torque_coeff value="0.004"/>
            </thrust_model>
            <propeller diameter="0.077" right="false">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mesh filename="cad_model_data/ccw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="thruster"/>
            </propeller>
        </actuator>

        <actuator name="TR" type="thruster">
            <link name="base_link"/>
            <origin xyz="0.00257 0.14631 0.00925" rpy="0 -1.5708 0"/>
            <specs max_setpoint="3600.0" inverted_setpoint="true" normalized_setpoint="false"/>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="fluid_dynamics">
                <rotor_constant value="0.001"/>
                <thrust_coeff forward="0.043" reverse="0.043"/>
                <torque_coeff value="0.004"/>
            </thrust_model>
            <propeller diameter="0.077" right="true">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mesh filename="cad_model_data/cw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="thruster"/>
            </propeller>
        </actuator>

        <actuator name="BL" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.08625 -0.13998 0.00651" rpy="0.0 0.0 0.0"/>
            <specs max_setpoint="3600.0" inverted_setpoint="false" normalized_setpoint="false"/>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="fluid_dynamics">
                <rotor_constant value="0.001"/>
                <thrust_coeff forward="0.043" reverse="0.043"/>
                <torque_coeff value="0.004"/>
            </thrust_model>
            <propeller diameter="0.077" right="true">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mesh filename="cad_model_data/cw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="thruster"/>
            </propeller>
        </actuator>

        <actuator name="BR" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.08569 0.14131 0.00771" rpy="0.0 0.0 0.0"/>
            <specs max_setpoint="3600.0" inverted_setpoint="true" normalized_setpoint="false"/>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="fluid_dynamics">
                <rotor_constant value="0.001"/>
                <thrust_coeff forward="0.043" reverse="0.043"/>
                <torque_coeff value="0.004"/>
            </thrust_model>
            <propeller diameter="0.077" right="false">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mesh filename="cad_model_data/ccw.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="thruster"/>
            </propeller>
        </actuator>

        <world_transform xyz="$(arg position)" rpy="$(arg orientation)"/>

        <!-- COMMENTING OUT SENSORS FOR THE TIME BEING -->
<!-- 
        <sensor name="camera" type="camera" rate="30">
            <specs resolution_x="640" resolution_y="480" horizontal_fov="75.0"/>
            <origin xyz="0.14816 -0.00046 -0.00106" rpy="0.0 0.0 0.0"/>
            <link name="base_link"/>
            <ros_publisher topic="/$(arg vehicle_name)/left"/>
        </sensor> 

        <sensor name="imu" type="imu" rate="50">
            <link name="base_link"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </sensor> 

        <sensor name="pressure" type="pressure" rate="5.0">
            <link name="base_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <noise pressure="5.0"/>
            <ros_publisher topic="/$(arg vehicle_name)/pressure"/>
        </sensor> 

        <sensor name="imu_filter" type="imu" rate="20.0">
            <link name="base_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <noise angle="0.000001745" angular_velocity="0.00001745"/>
            <ros_publisher topic="/$(arg vehicle_name)/imu"/>
        </sensor>    
-->

        <ros_subscriber thrusters="/$(arg vehicle_name)/setpoint/pwm"/>

    </robot>

</scenario>




