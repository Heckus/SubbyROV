<?xml version="1.0"?>
<scenario>

    <environment>
        <ned latitude="-27.47" longitude="153.03"/>

        <ocean>
            <water density="1031.0" temperature="20.0"/>
            <waves height="0.0"/>
            <particles enabled="true"/>

            <current type="uniform">
                <velocity xyz="0.0 0.0 0.0"/>
            </current>
        </ocean>

        <atmosphere>
            <sun azimuth="45.0" elevation="90.0"/>
        </atmosphere>
    </environment>

    <materials>
        <material name="HullMat" density="1000.0" restitution="0.3"/>
        <material name="Neutral" density="1000.0" restitution="0.3"/>
        <material name="PoolMat" density="2000.0" restitution="0.2"/>

        <friction_table>
            <friction material1="HullMat" material2="PoolMat" static="0.6" dynamic="0.4"/>
            <friction material1="PoolMat" material2="PoolMat" static="0.7" dynamic="0.5"/>
        </friction_table>
    </materials>

    <looks>
        <look name="pool_floor" rgb="0.45 0.55 0.60" roughness="0.8"/>
        <look name="pool_wall" rgb="0.55 0.65 0.70" roughness="0.8"/>
    </looks>

    <!-- Big pool floor -->
    <static name="pool_floor" type="box">
  
        <dimensions xyz="20.0 20.0 0.2"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
   
        <material name="PoolMat"/>
        <look name="pool_floor"/>
        <world_transform xyz="0.0 0.0 3.0" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Pool walls -->
    <static name="wall_front" type="box">
        <dimensions xyz="20.0 0.2 4.0"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="PoolMat"/>
        <look name="pool_wall"/>
        <world_transform xyz="0.0 10.0 1.5" rpy="0.0 0.0 0.0"/>
    </static>

    <static name="wall_back" type="box">
        <dimensions xyz="20.0 0.2 4.0"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="PoolMat"/>
        <look name="pool_wall"/>
        <world_transform xyz="0.0 -10.0 1.5" rpy="0.0 0.0 0.0"/>
    </static>

    <static name="wall_left" type="box">
        <dimensions xyz="0.2 20.0 4.0"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="PoolMat"/>
        <look name="pool_wall"/>
        <world_transform xyz="-10.0 0.0 1.5" rpy="0.0 0.0 0.0"/>
    </static>

    <static name="wall_right" type="box">
        <dimensions xyz="0.2 20.0 4.0"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="PoolMat"/>
        <look name="pool_wall"/>
        <world_transform xyz="10.0 0.0 1.5" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Include your ROV -->
    <!-- <include file="scenarios/stable_but_unrealistic.scn"> -->


    
    <include file="$(find stonefish_qut_rov)/scenarios/main_rov.scn">
        <arg name="vehicle_name" value="qut_rov"/>
        <arg name="position" value="0.0 0.0 0.5"/>
        <arg name="orientation" value="0.0 0.0 0.0"/>
    </include>

</scenario>
